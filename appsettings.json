{
  "ApplicationSettings": {
    "ApplicationName": "Gradual",
    "Version": "2.0.0",
    "DataDirectory": "data",
    "ProjectsFileName": "projects.json",
    "BackupDirectory": "backups",
    "EnableAutoBackup": true,
    "BackupIntervalMinutes": 30,
    "MaxBackupFiles": 10
  },
  "Logging": {
    "LogDirectory": "logs",
    "MinimumLevel": "Information",
    "EnableConsole": true,
    "EnableFile": true,
    "RetainedFileCountLimit": 30,
    "FileSizeLimitBytes": 10485760
  },
  "Analytics": {
    "Enabled": true,
    "TrackUserActions": true,
    "TrackPerformance": true,
    "SessionTimeout": 30
  },
  "Webhooks": {
    "Enabled": false,
    "Endpoints": []
  },
  "ErrorTracking": {
    "Enabled": true,
    "LogErrors": true,
    "ShowDetailedErrors": false,
    "EmailNotifications": false,
    "NotificationEmail": ""
  },
  "Validation": {
    "MaxProjectNameLength": 200,
    "MaxClientNameLength": 200,
    "MaxNotesLength": 5000,
    "MaxFolderPathLength": 500,
    "MaxPhases": 50,
    "MaxPhaseLength": 100,
    "MaxAttachments": 100
  },
  "UI": {
    "DefaultTheme": "Dark",
    "EnableAnimations": true,
    "AutoRefreshInterval": 0,
    "DefaultPageSize": 100
  },
  "GitHub": {
    "PersonalAccessToken": "",
    "ApplicationName": "Gradual",
    "EnableSync": true,
    "SyncIntervalMinutes": 30,
    "MaxCommitsPerSync": 100,
    "MaxIssuesPerSync": 50,
    "CacheExpirationMinutes": 15,
    "RateLimitWarningThreshold": 100,
    "DefaultBranch": "main"
  }
}
